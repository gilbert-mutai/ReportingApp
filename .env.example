# ============================================================
# Grafana Reporting Service — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -------- Grafana -----------------------------------------------
GRAFANA_URL=http://grafana:3000
# Service account token (preferred) or leave blank and use GRAFANA_USER/PASSWORD
GRAFANA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxx

# Web UI credentials used by Playwright for dashboard screenshots
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

GRAFANA_ORG_ID=1
GRAFANA_THEME=light          # light | dark
GRAFANA_WIDTH=1920
GRAFANA_HEIGHT=1080
GRAFANA_RENDER_TIMEOUT=60    # seconds
GRAFANA_SCREENSHOT_DELAY_MS=3000

# -------- Dashboards --------------------------------------------
# Comma-separated list of Grafana dashboard UIDs to capture
# Find the UID in the dashboard URL: /d/<UID>/dashboard-name
DASHBOARD_UIDS=abc123,def456
# Legacy single-dashboard support (overridden by DASHBOARD_UIDS if set)
# DASHBOARD_UID=abc123

# -------- Prometheus --------------------------------------------
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_TIMEOUT=30
PROMETHEUS_STEP=5m

# -------- Email — Microsoft Graph API (OAuth2) ------------------
# The mailbox the report is sent FROM (must be licensed in your M365 tenant)
EMAIL_HOST_USER=support@angani.co

# Azure App Registration credentials
# In Azure Portal → App registrations → your app → Overview
OAUTH2_CLIENT_ID=

# Azure Portal → App registrations → your app → Certificates & secrets
OAUTH2_CLIENT_SECRET=

# Azure Portal → App registrations → your app → Overview → Directory (tenant) ID
OAUTH2_TENANT_ID=

# HTTP timeout for token + send requests (seconds)
EMAIL_TIMEOUT=30

# Comma-separated list of recipient addresses
EMAIL_TO=gilbert@angani.co

# -------- Report ------------------------------------------------
REPORT_PERIOD=weekly           # weekly | monthly
REPORT_TITLE=Angani Internal Server Monitoring Report
COMPANY_NAME=Angani Limited
REPORT_OUTPUT_DIR=/reports
REPORT_TIMEZONE=Africa/Nairobi
INCLUDE_HTML_REPORT=false      # true to keep the intermediate HTML

# Path to company logo inside the container (assets/ is mounted as /app/assets)
COMPANY_LOGO=/app/assets/logo.png

# Optional free-text notes appended to every report
REPORT_NOTES=

# -------- Misc --------------------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
