# /etc/systemd/system/grafana-report-weekly.timer
#
# TESTING MODE: runs every 10 minutes.
# When ready for production, change OnCalendar back to: Mon *-*-* 08:00:00
#
# Install:
#   sudo cp grafana-report-weekly.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now grafana-report-weekly.timer
#
# Verify:
#   systemctl status grafana-report-weekly.timer
#   systemctl list-timers grafana-report-weekly.timer

[Unit]
Description=Weekly Grafana Monitoring Report — every Monday 08:00
Documentation=https://github.com/yourorg/grafana-reporting-service
After=network-online.target

[Timer]
# Every Monday at 08:00 local time
OnCalendar=Mon *-*-* 08:00:00

Persistent=true
RandomizedDelaySec=300
AccuracySec=60

Unit=grafana-report@weekly.service

[Install]
WantedBy=timers.target
